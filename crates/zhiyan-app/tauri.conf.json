{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知言",
  "version": "0.1.0",
  "identifier": "com.zhiyan.desktop",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "知言",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "visible": true,
        "dragDropEnabled": true
      },
      {
        "label": "quick",
        "title": "速记",
        "url": "quick.html",
        "width": 460,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "copyright": "Apache-2.0",
    "shortDescription": "卡片笔记",
    "longDescription": "三秒内记下一个念头，在合适的时候让它自己回来。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
